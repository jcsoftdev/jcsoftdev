---
/**
 * Footer — one line, not a sitemap.
 *
 * The rail carries navigation, socials and the email at every scroll position,
 * so the old four-column footer was repeating chrome the visitor could already
 * see. What is left is what a rail cannot say: what the site is built with, the
 * copyright, and a way back up.
 */
const year = new Date().getFullYear();

const builtWith = [
  "Astro 5",
  "Hono",
  "Drizzle",
  "React 19",
  "Tailwind v4",
] as const;
---

<footer
  class="border-t border-[color:var(--color-border)] bg-[color:var(--color-background)]"
>
  <div
    class="mx-auto flex w-full max-w-[75rem] flex-wrap items-center justify-between gap-x-8 gap-y-4 px-[var(--gutter)] py-7"
  >
    <p class="font-mono text-xs text-[color:var(--color-text-muted)]">
      © {year} Juan Carlos Valencia
    </p>

    <ul
      class="flex flex-wrap items-center gap-1.5 font-mono text-[11px] text-[color:var(--color-text-muted)]"
    >
      {
        builtWith.map((t) => (
          <li class="rounded-xs border border-[color:var(--color-border)] px-2 py-0.5">
            {t}
          </li>
        ))
      }
    </ul>

    <a
      href="#content"
      class="group inline-flex items-center gap-2 rounded-sm font-mono text-xs text-[color:var(--color-text-muted)] outline-none transition-colors hover:text-[color:var(--color-accent)] focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)]"
    >
      Back to top
      <span
        aria-hidden="true"
        class="transition-transform group-hover:-translate-y-0.5">↑</span
      >
    </a>
  </div>
</footer>
