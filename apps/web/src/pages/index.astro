---
/**
 * Home — single-page portfolio, rail layout.
 *
 * Hero → Selected Work → Experience → About → Contact.
 *
 * The chrome (nav, status, stack, contact) lives in SideRail and is on screen
 * at every scroll position, so the sections here carry content only: no
 * repeated stack list, no repeated email, and a contact section that no longer
 * has to be the page's single conversion point.
 */
import HeroIsland from "../components/HeroIsland.tsx";
import CopyEmail from "../components/islands/CopyEmail.tsx";
import { ExperienceIsland } from "../components/islands/ExperienceIsland.tsx";
import { ProjectsGrid } from "../components/islands/ProjectsGrid.tsx";
import RootLayout from "../layouts/RootLayout.astro";
import { fetchPortfolioResilient } from "../lib/portfolio-fetch";
import { buildPersonSchema, buildWebSiteSchema } from "../lib/seo";

export const prerender = false;

const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const canonicalUrl = `${siteOrigin}/`;

const pageTitle = "Juan Carlos Valencia — Senior Full-Stack Developer";
const pageDescription =
  "9 years building scalable web apps end-to-end. Currently designing a multi-tenant SaaS in Go + Next.js 16. Available for new work.";

const homeJsonLd = [buildPersonSchema(), buildWebSiteSchema()];

// Resilient by construction: live → last good → committed snapshot. The page
// can no longer render "0 projects" next to "Error loading data. Make sure the
// API is running." — which is what a hiring manager saw while the API was down.
const portfolio = await fetchPortfolioResilient();
const projects = portfolio.projects;
const experiences = portfolio.experiences;

/** Shared gutter. Fluid padding rather than stepped, because the column's width
 *  varies continuously with the rail. `mx-auto` self-activates: it does nothing
 *  until the column is wider than the max-width, so content stays left-aligned
 *  against the rail on ordinary screens and stops looking abandoned on an
 *  ultrawide one. */
const GUTTER = "mx-auto w-full max-w-[75rem] px-[var(--gutter)]";
const EYEBROW =
  "font-mono text-[10px] uppercase tracking-[0.2em] text-[color:var(--color-text-muted)]";
---

<RootLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  type="website"
  ogEyebrow="Portfolio"
  keywords={[
    "Juan Carlos Valencia",
    "jcsoftdev",
    "full-stack developer",
    "senior software engineer",
    "TypeScript",
    "Go",
    "React",
    "Next.js",
    "Hexagonal architecture",
    "Domain-Driven Design",
    "portfolio",
  ]}
  jsonLd={homeJsonLd}
>
  <main class="measure-grid">
    {
      /* Scroll progress — inset past the rail so it measures the column it tracks */
    }
    <div
      id="scroll-progress"
      aria-hidden="true"
      class="fixed top-0 z-[var(--z-header)] h-[2px] origin-left"
      style="left: var(--rail-w); width: calc(100% - var(--rail-w)); background: var(--color-accent); transform: scaleX(0); transition: transform 80ms linear;"
    >
    </div>

    {/* ── Hero ───────────────────────────────────────────────────── */}
    <HeroIsland client:idle />

    {/* ── Selected Work ──────────────────────────────────────────── */}
    <section
      id="work"
      data-reveal
      class="scroll-mt-[var(--header-height)] border-t border-[color:var(--color-border)]"
    >
      <div class={`${GUTTER} pt-[var(--section-py)] pb-4`}>
        <div class="flex items-end justify-between gap-6 pb-4">
          <div class="space-y-2.5">
            <span data-reveal-item class={`${EYEBROW} block`}>
              Selected work
            </span>
            <h2
              data-reveal-item
              class="max-w-[24ch] font-display text-[clamp(1.5rem,1.25rem+1.1vw,2rem)] font-semibold leading-[1.1] tracking-tight text-[color:var(--color-text-primary)]"
            >
              Things I've shipped over the years.
            </h2>
          </div>
          <span
            data-reveal-item
            class="hidden shrink-0 font-mono text-xs italic text-[color:var(--color-text-muted)] @xl:inline-flex"
          >
            {projects.length}
            {projects.length === 1 ? "project" : "projects"}
          </span>
        </div>
      </div>
      <div data-reveal-item class={`${GUTTER} pb-[var(--section-py)]`}>
        <ProjectsGrid projects={projects} client:visible />
      </div>
    </section>

    {/* ── Experience ─────────────────────────────────────────────── */}
    <section
      id="experience"
      data-reveal
      class="scroll-mt-[var(--header-height)] border-t border-[color:var(--color-border)]"
    >
      <div class={`${GUTTER} pt-[var(--section-py)] pb-4`}>
        <div class="flex items-baseline justify-between gap-6 pb-4">
          <span data-reveal-item class={EYEBROW}>Experience</span>
          <span
            data-reveal-item
            class="font-mono text-xs italic text-[color:var(--color-text-muted)]"
          >
            {experiences.length}
            {experiences.length === 1 ? "role" : "roles"} · 9 years
          </span>
        </div>
      </div>
      <div data-reveal-item class={`${GUTTER} pb-[var(--section-py)]`}>
        <ExperienceIsland experiences={experiences} client:visible />
      </div>
    </section>

    {/* ── About ──────────────────────────────────────────────────── */}
    <section
      id="about"
      data-reveal
      class="scroll-mt-[var(--header-height)] border-t border-[color:var(--color-border)]"
    >
      <div
        class={`${GUTTER} grid gap-8 py-[var(--section-py)] @5xl:grid-cols-[minmax(0,1fr)_22rem] @5xl:gap-10`}
      >
        <div class="flex flex-col gap-5">
          <span data-reveal-item class={EYEBROW}>About</span>
          <h2
            data-reveal-item
            class="font-display text-[clamp(1.5rem,1.25rem+1.1vw,2rem)] font-semibold leading-[1.1] tracking-tight text-[color:var(--color-text-primary)]"
          >
            The shape of my work.
          </h2>
          <p
            data-reveal-item
            class="max-w-[58ch] text-lg leading-relaxed text-[color:var(--color-text-primary)]"
          >
            I care about <em
              class="font-medium not-italic text-[color:var(--color-text-primary)]"
              >clean architecture</em
            >
            (Hexagonal, DDD, Screaming),
            <em
              class="font-medium not-italic text-[color:var(--color-text-primary)]"
              >performance</em
            >
            (SSR/SSG, caching, query tuning), and
            <em
              class="font-medium not-italic text-[color:var(--color-text-primary)]"
              >teaching</em
            >
            — writing, code review, and pairing with anyone willing to push past their
            comfort zone.
          </p>
          <p
            data-reveal-item
            class="max-w-[58ch] leading-relaxed text-[color:var(--color-text-secondary)]"
          >
            Comfortable across the stack — frontend, backend, data, infra.
            Allergic to shortcuts.
          </p>

          {
            /* Reading used to be a stat cell doing nothing. It belongs next to
              the writing it feeds. */
          }
          <div
            data-reveal-item
            class="mt-2 flex flex-wrap items-center justify-between gap-4 rounded-md border border-[color:var(--color-border)] bg-[color:var(--color-surface)] px-5 py-4"
          >
            <div class="flex flex-col gap-1">
              <span class={EYEBROW}>Currently reading</span>
              <span class="font-medium text-[color:var(--color-text-primary)]"
                >Designing Data-Intensive Applications</span
              >
            </div>
            <a
              href="/blog"
              class="inline-flex items-center gap-2 rounded-sm font-mono text-xs uppercase tracking-[0.12em] text-[color:var(--color-accent)] outline-none transition-colors hover:text-[color:var(--color-accent-hover)] focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)]"
            >
              Notes
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        {
          /* Numbers readout — only figures that are actually true. "Companies: 7"
            is gone: over nine years it reads as churn as easily as breadth, and
            the number alone cannot say which. */
        }
        <aside data-reveal-item class="@5xl:pt-9">
          <div
            class="panel-frame rounded-md border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-5"
          >
            <p class={`${EYEBROW} mb-4`}>By the numbers</p>
            <dl class="flex flex-col">
              <div
                class="flex items-baseline justify-between gap-3 border-b border-[color:var(--color-border)] pb-3"
              >
                <dt
                  class="font-mono text-xs text-[color:var(--color-text-muted)]"
                >
                  Shipping since
                </dt>
                <dd
                  class="font-display text-2xl font-semibold tabular-nums text-[color:var(--color-text-primary)]"
                >
                  2017
                </dd>
              </div>
              <div
                class="flex items-baseline justify-between gap-3 border-b border-[color:var(--color-border)] py-3"
              >
                <dt
                  class="font-mono text-xs text-[color:var(--color-text-muted)]"
                >
                  Projects shipped
                </dt>
                <dd
                  class="font-display text-2xl font-semibold tabular-nums text-[color:var(--color-text-primary)]"
                >
                  {projects.length}<span
                    class="text-[color:var(--color-accent)]">+</span
                  >
                </dd>
              </div>
              <div class="flex items-baseline justify-between gap-3 pt-3">
                <dt
                  class="font-mono text-xs text-[color:var(--color-text-muted)]"
                >
                  Roles
                </dt>
                <dd
                  class="font-display text-2xl font-semibold tabular-nums text-[color:var(--color-text-primary)]"
                >
                  {experiences.length}
                </dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </section>

    {/* ── Contact ────────────────────────────────────────────────── */}
    <section
      id="contact"
      data-reveal
      class="relative scroll-mt-[var(--header-height)] overflow-hidden border-t border-[color:var(--color-border)]"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute right-[-20%] top-1/2 h-[46vmax] w-[46vmax] -translate-y-1/2 rounded-full"
        style="background: radial-gradient(circle, oklch(0.70 0.20 249 / 0.14) 0%, transparent 65%); filter: blur(80px); z-index: var(--z-orbs);"
      >
      </div>

      <div
        class={`${GUTTER} relative py-[var(--section-py)]`}
        style="z-index: var(--z-content);"
      >
        <div class="max-w-[58ch] space-y-4">
          <div data-reveal-item class="flex items-center gap-3">
            <span
              class="inline-block h-2 w-2 rounded-full bg-[color:var(--color-success)] [box-shadow:0_0_12px_var(--color-success)]"
            ></span>
            <span class={EYEBROW}>Get in touch</span>
          </div>
          <h2
            data-reveal-item
            class="font-display text-[clamp(1.875rem,1.35rem+2.4vw,3rem)] font-semibold leading-[1.02] tracking-[-0.03em] text-[color:var(--color-text-primary)]"
          >
            Have a problem worth <em
              class="not-italic text-[color:var(--color-accent)]">solving?</em
            >
          </h2>
          <p
            data-reveal-item
            class="text-lg italic text-[color:var(--color-text-secondary)]"
          >
            If your team needs an extra senior engineer who ships, mentors, and
            thinks in systems — let's talk.
          </p>
        </div>

        <div
          class="mt-8 grid gap-8 border-t border-[color:var(--color-border)] pt-8 @5xl:grid-cols-[minmax(0,1fr)_22rem]"
        >
          <div data-reveal-item class="flex flex-col gap-3">
            <span class={EYEBROW}>Primary · Email</span>
            <CopyEmail
              client:visible
              email="hello@jcsoftdev.com"
              note="Replies under 24h on weekdays"
            />
          </div>

          <div data-reveal-item class="flex flex-col gap-2.5">
            <span class={EYEBROW}>Or find me on</span>
            <ul class="flex flex-col gap-2">
              {
                [
                  {
                    label: "github",
                    handle: "/jcsoftdev",
                    href: "https://github.com/jcsoftdev",
                    external: true,
                  },
                  {
                    label: "linkedin",
                    handle: "/in/jcsoftdev",
                    href: "https://linkedin.com/in/jcsoftdev",
                    external: true,
                  },
                  {
                    label: "blog",
                    handle: "/writing",
                    href: "/blog",
                    external: false,
                  },
                  {
                    label: "rss",
                    handle: "/rss.xml",
                    href: "/rss.xml",
                    external: false,
                  },
                ].map(({ label, handle, href, external }) => (
                  <li>
                    <a
                      href={href}
                      {...(external
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                      class="group flex items-center justify-between rounded-sm border border-[color:var(--color-border)] bg-[color:var(--color-surface)] px-4 py-3 font-mono text-sm text-[color:var(--color-text-secondary)] outline-none transition-colors duration-[var(--duration-fast)] hover:border-[color:var(--color-accent-muted)] hover:text-[color:var(--color-text-primary)] focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)]"
                    >
                      <span class="flex items-center gap-3">
                        <span class="text-[color:var(--color-text-muted)]">
                          {label}
                        </span>
                        <span>{handle}</span>
                      </span>
                      <span
                        aria-hidden="true"
                        class="text-[color:var(--color-text-muted)] transition-[color,transform] group-hover:translate-x-1 group-hover:text-[color:var(--color-accent)]"
                      >
                        →
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>
</RootLayout>

<script is:inline>
  // Mark JS as available BEFORE any [data-reveal-item] elements render their CSS
  // — prevents flash-of-invisible-content if JS fails or is disabled.
  document.documentElement.classList.add("js");
</script>

<script>
  // Scroll progress bar — pure scroll math, no animation library needed.
  const initProgress = () => {
    const bar = document.getElementById("scroll-progress");
    if (!bar) return;
    // Runs on module execution and again on astro:page-load — bind once, or the
    // window collects a scroll listener per navigation.
    if (bar.dataset.bound === "true") return;
    bar.dataset.bound = "true";
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
      bar.style.transform = `scaleX(${ratio})`;
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  };

  // Reveal animations — IntersectionObserver + CSS transitions.
  let activeObserver: IntersectionObserver | null = null;

  const initReveals = () => {
    activeObserver?.disconnect();
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      // The CSS media query below handles the no-animation state.
      return;
    }

    const sections = document.querySelectorAll<HTMLElement>("[data-reveal]");
    activeObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const section = entry.target as HTMLElement;
          const items =
            section.querySelectorAll<HTMLElement>("[data-reveal-item]");
          if (items.length === 0) {
            section.classList.add("is-revealed");
          } else {
            items.forEach((item, i) => {
              item.style.setProperty("--reveal-delay", `${i * 55}ms`);
              item.classList.add("is-revealed");
            });
          }
          activeObserver?.unobserve(section);
        }
      },
      { threshold: 0.1, rootMargin: "0px 0px -8% 0px" },
    );

    for (const section of sections) activeObserver.observe(section);
  };

  const init = () => {
    initProgress();
    initReveals();
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>

<style is:global>
  /* Reveal items: hidden until intersection, then transition in.
     The 8px blur the previous pass used is gone — in a dense rail layout it
     kept text unreadable while it was already on screen, and it costs a paint
     on every frame of the transition. Fade plus a short lift does the job. */
  html.js [data-reveal-item] {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.5s var(--ease-out-expo),
      transform 0.5s var(--ease-out-expo);
    transition-delay: var(--reveal-delay, 0ms);
  }
  html.js [data-reveal-item].is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  /* Section-level fallback for [data-reveal] blocks with no marked items. */
  html.js [data-reveal]:not(:has([data-reveal-item])) {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.5s var(--ease-out-expo),
      transform 0.5s var(--ease-out-expo);
  }
  html.js [data-reveal]:not(:has([data-reveal-item])).is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    html.js [data-reveal-item],
    html.js [data-reveal]:not(:has([data-reveal-item])) {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
