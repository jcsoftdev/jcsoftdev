---
/**
 * Blog post page — Phase 7.2
 *
 * SSR — renders a single published post fetched by slug from the API.
 * The API returns pre-compiled MDX HTML (cached in Valkey by the public-blog route).
 * This page is a thin presentation layer: it receives HTML and renders it.
 * Styled with the landing's display language (styles/blog.css).
 *
 * Route: /blog/[slug]
 *
 * API: GET /api/v1/public/blog/:slug → { post, html }
 *   - Returns 404 for unknown slugs
 *   - Returns 404 for draft / archived posts (not visible publicly)
 *
 * Hero image strategy (Phase 7 resolution):
 *   The API currently returns `heroMediaId` (UUID) not a signed URL.
 *   Signed GET URL generation is deferred to a future API update.
 *   Hero image is only rendered when a URL is present in the response.
 *
 * SEO: basic <title> from post title + <meta name="description"> from excerpt.
 * Full OG/SEO meta is deferred to the `seo` change.
 *
 * Reading column: var(--reading-column) (65ch) per REQ-BLOG-3, with a sticky
 * table of contents beside it from 1024px.
 * The API HTML is already sanitized; the only transformation done here is
 * adding id attributes to h2/h3 (lib/post-headings.ts).
 */
import RootLayout from "../../layouts/RootLayout.astro";
import SplitHeading from "../../components/SplitHeading.astro";
import {
  buildHeroImageUrl,
  fetchBlogPost,
  fetchBlogPosts,
  type PublicPost,
} from "../../lib/blog-fetch";
import { formatPostDate } from "../../lib/post-date";
import { addHeadingIds } from "../../lib/post-headings";
import { readingTimeMinutes } from "../../lib/reading-time";
import {
  buildBlogPostingSchema,
  buildBreadcrumbSchema,
  SITE_URL,
} from "../../lib/seo";
import "../../styles/blog.css";

// SSR — no prerender
export const prerender = false;

const { slug } = Astro.params;

// fetchBlogPost returns null for 404 (not found or draft)
const result = await fetchBlogPost(slug!);

if (!result) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const { post, html } = result;

// Hero image URL — provided directly by the API when heroMediaId is set.
// The API constructs: ${MINIO_PUBLIC_URL}/${bucket}/${objectKey}
const heroImageUrl = buildHeroImageUrl(post.heroImageUrl);

// Anchor ids on h2/h3 (id attributes only) + the outline for the TOC.
const { html: proseHtml, toc } = addHeadingIds(html);
const minutes = readingTimeMinutes(html);
const publishedLabel = formatPostDate(post.publishedAt);
const canonical = `${SITE_URL}/blog/${post.slug}`;

// "More writing" is a nicety: bounded wait, and any failure just hides it.
const MORE_WAIT_MS = 1500;
let more: PublicPost[] = [];
try {
  const listing = await Promise.race([
    fetchBlogPosts({ cursor: null, limit: 4 }),
    new Promise<never>((_, reject) =>
      setTimeout(() => reject(new Error("timeout")), MORE_WAIT_MS),
    ),
  ]);
  more = listing.items.filter((p) => p.slug !== post.slug).slice(0, 3);
} catch {
  more = [];
}

const pageTitle = `${post.title} — jcsoftdev`;
const pageDescription = post.excerpt ?? `Read "${post.title}" on jcsoftdev`;

const articleJsonLd = [
  buildBlogPostingSchema({
    slug: post.slug,
    title: post.title,
    excerpt: post.excerpt,
    publishedAt: post.publishedAt,
    updatedAt: post.updatedAt,
    heroImageUrl,
  }),
  buildBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Writing", url: "/blog" },
    { name: post.title, url: `/blog/${post.slug}` },
  ]),
];
---

<RootLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  type="article"
  publishedTime={post.publishedAt ?? undefined}
  modifiedTime={post.updatedAt}
  image={heroImageUrl ?? undefined}
  imageAlt={post.title}
  ogEyebrow="Writing"
  jsonLd={articleJsonLd}
>
  <div
    id="scroll-progress"
    aria-hidden="true"
    class="fixed top-0 z-[var(--z-header)] h-[2px] origin-left motion-reduce:hidden"
    style="left: var(--rail-w); width: calc(100% - var(--rail-w)); background: var(--color-accent); transform: scaleX(0); transition: transform 80ms linear;"
  >
  </div>

  <main class="blog-page">
    <article class="blog-shell">
      <header data-reveal class="post-head">
        <a data-reveal-item href="/blog" class="post-back">
          <span aria-hidden="true">&larr;</span> Writing
        </a>
        <SplitHeading as="h1" text={post.title} class="post-title" />
        <div data-reveal-item class="post-meta">
          {
            publishedLabel && post.publishedAt && (
              <time datetime={post.publishedAt}>{publishedLabel}</time>
            )
          }
          {publishedLabel && <span class="post-meta__dot" aria-hidden="true" />}
          <span>{minutes} min read</span>
        </div>
        {
          post.excerpt && (
            <p data-reveal-item class="post-excerpt">
              {post.excerpt}
            </p>
          )
        }
      </header>

      {
        heroImageUrl && (
          <img
            src={heroImageUrl}
            alt={post.title}
            class="post-hero"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        )
      }

      <div class:list={["post-layout", toc.length >= 2 && "post-layout--toc"]}>
        <div class="post-body">
          {
            /* Sanitized server-side per ADR-14; only id attributes were added. */
          }
          <div class="post-prose" set:html={proseHtml} />

          <footer class="post-foot">
            <a href="/blog" class="blog-link">
              <span aria-hidden="true">&larr;</span> All writing
            </a>
            <button type="button" class="blog-link" data-copy-link={canonical}>
              <span data-copy-label aria-live="polite">Copy link</span>
            </button>
          </footer>
        </div>

        {
          toc.length >= 2 && (
            <nav class="post-toc" aria-label="Table of contents" data-toc>
              <span class="eyebrow-label">On this page</span>
              <ul class="post-toc__list">
                {toc.map((entry) => (
                  <li>
                    <a
                      href={`#${entry.id}`}
                      class:list={[
                        "post-toc__link",
                        entry.level === 3 && "post-toc__link--sub",
                      ]}
                    >
                      {entry.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>

      {
        more.length > 0 && (
          <section class="post-more" aria-labelledby="more-writing">
            <div class="post-more__head">
              <h2 id="more-writing" class="eyebrow-label">
                More writing
              </h2>
              <a href="/blog" class="post-back">
                All posts <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
            <ul role="list" class="blog-list">
              {more.map((p, i) => (
                <li>
                  <a href={`/blog/${p.slug}`} class="blog-row">
                    <span
                      class="display-numeral blog-row__numeral"
                      aria-hidden="true"
                    >
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <div>
                      <h3 class="blog-row__title">{p.title}</h3>
                    </div>
                    <div class="blog-row__meta">
                      {p.publishedAt && (
                        <time datetime={p.publishedAt}>
                          {formatPostDate(p.publishedAt)}
                        </time>
                      )}
                      <span class="blog-row__arrow" aria-hidden="true">
                        &rarr;
                      </span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>
  </main>
</RootLayout>

<script is:inline>
  // JS marker first, so [data-reveal-item] only hides when it can be released.
  document.documentElement.classList.add("js");
</script>

<script>
  import "../../scripts/blog-client";
</script>
