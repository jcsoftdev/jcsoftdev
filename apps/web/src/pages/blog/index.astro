---
/**
 * Blog index page — Phase 7.1
 *
 * SSR (output: 'server' is the default for this project — astro.config.ts).
 * Renders a cursor-paginated list of published posts fetched from the API.
 * Styled with the landing's display language (styles/blog.css).
 *
 * Route: /blog
 * Query params: ?cursor=<opaque>&limit=<number>
 *
 * API: GET /api/v1/public/blog
 * Client: blog-fetch helpers (fetchBlogPosts, parseCursorFromUrl)
 * No auth — public route.
 */
import RootLayout from "../../layouts/RootLayout.astro";
import SplitHeading from "../../components/SplitHeading.astro";
import { fetchBlogPosts, parseCursorFromUrl } from "../../lib/blog-fetch";
import { formatPostDate, postNumeral } from "../../lib/post-date";
import {
  buildBlogSchema,
  buildBreadcrumbSchema,
  SITE_URL,
} from "../../lib/seo";
import "../../styles/blog.css";

// SSR — no prerender
export const prerender = false;

// Parse query params from the incoming request URL
const url = new URL(Astro.request.url);
const cursor = parseCursorFromUrl(url);
const rawLimit = url.searchParams.get("limit");
const limit = rawLimit
  ? Math.min(Math.max(parseInt(rawLimit, 10) || 10, 1), 50)
  : 10;

// Fetch posts from API
let items: Awaited<ReturnType<typeof fetchBlogPosts>>["items"] = [];
let nextCursor: string | null = null;
let fetchError: string | null = null;

try {
  const result = await fetchBlogPosts({ cursor, limit });
  items = result.items;
  nextCursor = result.nextCursor;
} catch (err) {
  fetchError = err instanceof Error ? err.message : "Failed to load posts";
}

// Build pagination URLs
const prevUrl = cursor ? `/blog` : null; // No true "prev" with cursor pagination — only "home"
const nextUrl = nextCursor
  ? `/blog?cursor=${encodeURIComponent(nextCursor)}&limit=${limit}`
  : null;

const blogJsonLd = [
  buildBlogSchema(),
  buildBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Writing", url: "/blog" },
  ]),
];

// Paginated pages should not be indexed as duplicates of /blog.
const isPaginated = cursor !== null;

// The latest post leads as a featured row, but only on the first page.
const featured = !isPaginated ? (items[0] ?? null) : null;
const rows = featured ? items.slice(1) : items;
const rowOffset = featured ? 2 : 1;
---

<RootLayout
  title="Writing — jcsoftdev"
  description="Engineering articles, tutorials, and notes on full-stack development by Juan Carlos Valencia."
  canonical={`${SITE_URL}/blog`}
  type="website"
  ogEyebrow="Writing"
  noindex={isPaginated}
  keywords={[
    "blog",
    "engineering",
    "tutorials",
    "TypeScript",
    "Go",
    "React",
    "architecture",
  ]}
  jsonLd={blogJsonLd}
>
  <main class="blog-page">
    <div class="blog-shell">
      <header data-reveal class="blog-head">
        <span data-reveal-item class="eyebrow-label">Writing</span>
        <SplitHeading as="h1" text="Notes & articles" accentFrom={2} />
        <p data-reveal-item class="blog-lede">
          Engineering articles, tutorials and notes on full-stack development.
        </p>
      </header>

      {
        fetchError ? (
          <section class="blog-notice blog-notice--error" role="alert">
            <h2 class="blog-notice__title">Could not load posts</h2>
            <p class="blog-notice__body">{fetchError}</p>
            <a class="blog-link" href="/blog">
              Try again
            </a>
          </section>
        ) : items.length === 0 ? (
          <section class="blog-notice">
            <h2 class="blog-notice__title">No posts yet</h2>
            <p class="blog-notice__body">
              Nothing has been published here yet. Check back soon.
            </p>
            <a class="blog-link" href="/">
              Back home
            </a>
          </section>
        ) : (
          <ol role="list" data-reveal class="blog-list">
            {featured && (
              <li data-reveal-item>
                <a
                  href={`/blog/${featured.slug}`}
                  class:list={[
                    "blog-featured",
                    featured.heroImageUrl && "blog-featured--media",
                  ]}
                >
                  <div class="blog-featured__copy">
                    <div>
                      <span class="eyebrow-label">Latest</span>
                      <h2
                        class="blog-featured__title"
                        style="margin-top: 1rem;"
                      >
                        {featured.title}
                      </h2>
                      {featured.excerpt && (
                        <p class="blog-featured__excerpt">{featured.excerpt}</p>
                      )}
                    </div>
                    <div class="blog-row__meta">
                      {featured.publishedAt && (
                        <time datetime={featured.publishedAt}>
                          {formatPostDate(featured.publishedAt)}
                        </time>
                      )}
                      <span class="blog-row__arrow" aria-hidden="true">
                        &rarr;
                      </span>
                    </div>
                  </div>
                  {featured.heroImageUrl && (
                    <img
                      class="blog-featured__media"
                      src={featured.heroImageUrl}
                      alt=""
                      loading="eager"
                      decoding="async"
                    />
                  )}
                </a>
              </li>
            )}
            {rows.map((post, i) => (
              <li data-reveal-item>
                <a href={`/blog/${post.slug}`} class="blog-row">
                  <span
                    class="display-numeral blog-row__numeral"
                    aria-hidden="true"
                  >
                    {postNumeral(i + rowOffset)}
                  </span>
                  <div>
                    <h2 class="blog-row__title">{post.title}</h2>
                    {post.excerpt && (
                      <p class="blog-row__excerpt">{post.excerpt}</p>
                    )}
                  </div>
                  <div class="blog-row__meta">
                    {post.publishedAt && (
                      <time datetime={post.publishedAt}>
                        {formatPostDate(post.publishedAt)}
                      </time>
                    )}
                    <span class="blog-row__arrow" aria-hidden="true">
                      &rarr;
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ol>
        )
      }

      {
        (prevUrl || nextUrl) && (
          <nav class="blog-pager" aria-label="Blog pagination">
            {prevUrl ? (
              <a class="blog-link" href={prevUrl}>
                <span aria-hidden="true">&larr;</span> Latest
              </a>
            ) : (
              <span />
            )}
            {nextUrl ? (
              <a class="blog-link" href={nextUrl} rel="next">
                Older <span aria-hidden="true">&rarr;</span>
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }
    </div>
  </main>
</RootLayout>

<script is:inline>
  // JS marker first, so [data-reveal-item] only hides when it can be released.
  document.documentElement.classList.add("js");
</script>

<script>
  import "../../scripts/blog-client";
</script>
