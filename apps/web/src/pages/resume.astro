---
/**
 * /resume — the CV, matching the PDF handed to recruiters.
 *
 * It used to render the portfolio payload the homepage fetches, which meant it
 * could not drift from the Experience section — and also that it could only
 * show what that payload carries: company, role, dates, one summary. The PDF
 * has a profile, a skills matrix, core competencies, a stack and bullet list
 * per engagement, and an education section. None of that fits the database.
 *
 * So the content comes from `resume.data.ts`, transcribed from the PDF. The
 * homepage still reads the database, and the two CAN now disagree — the
 * deliberate trade being that the page you send someone should say exactly what
 * the file you send them says.
 *
 * Cmd-P produces a clean single-column PDF via the print block at the bottom.
 */
import RootLayout from "../layouts/RootLayout.astro";
import {
  CERTIFICATIONS,
  CORE_COMPETENCIES,
  EDUCATION,
  EXPERIENCE,
  PRINT_ONLY_CONTACT,
  PROFILE,
  TECHNICAL_SKILLS,
} from "../lib/resume.data";
import {
  AUTHOR_EMAIL,
  AUTHOR_GITHUB,
  AUTHOR_LINKEDIN,
  SITE_URL,
  buildBreadcrumbSchema,
} from "../lib/seo";

export const prerender = false;

const jsonLd = [
  buildBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Résumé", url: "/resume" },
  ]),
];
---

<RootLayout
  title="Résumé — Juan Carlos Valencia"
  description="Senior full-stack developer. 8+ years building complete web products, from the frontend to the infrastructure. TypeScript, React/Next.js, Node.js/NestJS, Go, Python, PostgreSQL, AWS and Azure."
  canonical={`${SITE_URL}/resume`}
  type="website"
  ogEyebrow="Résumé"
  keywords={["résumé", "CV", "Juan Carlos Valencia", "full-stack developer"]}
  jsonLd={jsonLd}
>
  <main class="resume mx-auto w-full max-w-[54rem] px-6 py-16 lg:px-8">
    <header class="resume-head">
      <h1
        class="font-display text-4xl font-semibold tracking-tight text-[color:var(--color-text-primary)]"
      >
        Juan Carlos Valencia López
      </h1>
      <p class="mt-1 font-mono text-sm text-[color:var(--color-accent)]">
        Senior Full-Stack Developer
      </p>
      <ul
        data-contact-list
        class="mt-4 flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs text-[color:var(--color-text-muted)]"
      >
        <li><a href={`mailto:${AUTHOR_EMAIL}`}>{AUTHOR_EMAIL}</a></li>
        <li><a href={AUTHOR_LINKEDIN}>linkedin.com/in/jcsoftdev</a></li>
        <li><a href={AUTHOR_GITHUB}>github.com/jcsoftdev</a></li>
        <li><a href={SITE_URL}>jcsoftdev.com</a></li>
      </ul>

      <p
        class="no-print mt-6 font-mono text-xs text-[color:var(--color-text-muted)]"
      >
        Press <kbd>Cmd</kbd>/<kbd>Ctrl</kbd> + <kbd>P</kbd> to save as PDF — the printed
        copy adds a phone number and direct email that are kept off this page.
      </p>
    </header>

    <section class="mt-10 break-inside-avoid">
      <h2 class="resume-h2">Profile</h2>
      <p
        class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-text-secondary)]"
      >
        {PROFILE}
      </p>
    </section>

    <section class="mt-10">
      <h2 class="resume-h2">Technical Skills</h2>
      <dl class="mt-3 flex flex-col gap-2.5">
        {
          TECHNICAL_SKILLS.map(({ label, value }) => (
            <div class="grid break-inside-avoid gap-x-5 gap-y-0.5 sm:grid-cols-[150px_minmax(0,1fr)]">
              <dt class="font-mono text-xs text-[color:var(--color-text-primary)]">
                {label}
              </dt>
              <dd class="text-[15px] leading-relaxed text-[color:var(--color-text-secondary)]">
                {value}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-10 break-inside-avoid">
      <h2 class="resume-h2">Core Competencies</h2>
      {/* Two columns, as printed — collapses to one on a narrow screen. */}
      <ul
        class="mt-3 grid gap-x-8 gap-y-1.5 text-[15px] leading-relaxed text-[color:var(--color-text-secondary)] sm:grid-cols-2"
      >
        {
          CORE_COMPETENCIES.map((item) => (
            <li class="resume-dash break-inside-avoid">{item}</li>
          ))
        }
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="resume-h2">Experience</h2>
      <ol class="mt-4 flex flex-col gap-8">
        {
          EXPERIENCE.map((role) => (
            <li>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 border-b border-[color:var(--color-border-soft)] pb-1.5">
                <h3 class="font-display text-lg font-semibold text-[color:var(--color-text-primary)]">
                  {role.role}
                  <span class="text-[color:var(--color-text-muted)]">
                    {" · "}
                    {role.company}
                  </span>
                </h3>
                <span class="font-mono text-xs text-[color:var(--color-text-muted)]">
                  {role.period}
                </span>
              </div>

              {role.stack && <p class="resume-stack">{role.stack}</p>}

              {role.summary && (
                <p class="mt-2 text-[15px] leading-relaxed text-[color:var(--color-text-secondary)]">
                  {role.summary}
                </p>
              )}

              {role.bullets && role.bullets.length > 0 && (
                <ul class="resume-bullets">
                  {role.bullets.map((b) => (
                    <li class="break-inside-avoid">{b}</li>
                  ))}
                </ul>
              )}

              {role.projects && role.projects.length > 0 && (
                <ol class="mt-5 flex flex-col gap-5">
                  {role.projects.map((project) => (
                    <li>
                      {project.label && (
                        <p class="resume-label">{project.label}</p>
                      )}
                      <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                        <h4 class="font-display text-[15px] font-semibold text-[color:var(--color-text-primary)]">
                          {project.name}
                        </h4>
                        {project.period && (
                          <span class="font-mono text-[11px] text-[color:var(--color-text-muted)]">
                            {project.period}
                          </span>
                        )}
                      </div>

                      <p class="resume-stack">{project.stack}</p>

                      <p class="mt-1.5 text-[15px] leading-relaxed text-[color:var(--color-text-secondary)]">
                        {project.summary}
                      </p>

                      <ul class="resume-bullets">
                        {project.bullets.map((b) => (
                          <li class="break-inside-avoid">{b}</li>
                        ))}
                      </ul>

                      {project.subsections?.map((sub) => (
                        <div class="mt-4 border-l border-[color:var(--color-border-soft)] pl-4">
                          {sub.label && <p class="resume-label">{sub.label}</p>}
                          <h5 class="font-display text-[15px] font-semibold text-[color:var(--color-text-primary)]">
                            {sub.name}
                          </h5>
                          <p class="resume-stack">{sub.stack}</p>
                          <p class="mt-1.5 text-[15px] leading-relaxed text-[color:var(--color-text-secondary)]">
                            {sub.summary}
                          </p>
                          <ul class="resume-bullets">
                            {sub.bullets.map((b) => (
                              <li class="break-inside-avoid">{b}</li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-10 break-inside-avoid">
      <h2 class="resume-h2">Education &amp; Certifications</h2>
      <div class="mt-3 grid gap-8 sm:grid-cols-2">
        <div>
          <h3
            class="font-display text-base font-semibold text-[color:var(--color-text-primary)]"
          >
            {EDUCATION.degree}
          </h3>
          <p class="font-mono text-xs text-[color:var(--color-text-muted)]">
            {EDUCATION.school}
          </p>
          <p
            class="mt-1.5 text-[15px] leading-relaxed text-[color:var(--color-text-secondary)]"
          >
            {EDUCATION.detail}
          </p>
        </div>
        <div>
          <p
            class="font-mono text-[10px] uppercase tracking-[0.18em] text-[color:var(--color-text-muted)]"
          >
            Courses &amp; Certifications
          </p>
          <ul
            class="mt-2 flex flex-col gap-1.5 text-[15px] leading-relaxed text-[color:var(--color-text-secondary)]"
          >
            {CERTIFICATIONS.map((c) => <li class="resume-dash">{c}</li>)}
          </ul>
        </div>
      </div>
    </section>
  </main>
</RootLayout>

<script is:inline define:vars={{ printOnly: PRINT_ONLY_CONTACT }}>
  // The phone number and direct email reach the printed CV without appearing on
  // the page. Two things make that work, and neither is `display: none` — that
  // still ships the text in the markup, which is exactly what an address
  // harvester reads.
  //
  // The values arrive base64-encoded and are decoded only here, so the served
  // HTML contains no email pattern and no phone number to match on. This is
  // obfuscation, not protection: anything the browser renders can be extracted
  // by anyone willing to run the same atob. It defeats the naive harvester,
  // which is nearly all of them, and nothing more.
  //
  // If JavaScript is off the print simply lacks them — the same result as not
  // having built this. Nothing else on the page depends on it.
  (() => {
    const list = document.querySelector("[data-contact-list]");
    if (!list || list.dataset.printBound === "true") return;
    list.dataset.printBound = "true";

    let injected = [];

    const add = () => {
      if (injected.length > 0) return;
      injected = printOnly.map(({ value, href }) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = atob(href);
        a.textContent = atob(value);
        li.appendChild(a);
        list.appendChild(li);
        return li;
      });
    };

    const remove = () => {
      for (const li of injected) li.remove();
      injected = [];
    };

    // beforeprint/afterprint covers Chrome, Firefox and Safari 13+. The print
    // media query is wired too because some paths into printing flip the query
    // without firing the event; `add` and `remove` are idempotent, so a browser
    // that does both is harmless.
    window.addEventListener("beforeprint", add);
    window.addEventListener("afterprint", remove);

    window
      .matchMedia("print")
      .addEventListener("change", (event) =>
        event.matches ? add() : remove(),
      );
  })();
</script>

<style is:global>
  .resume-h2 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border-soft);
    padding-bottom: 0.5rem;
  }

  /* The em dash the PDF uses as a bullet, rather than a disc. */
  .resume-dash {
    padding-left: 1.1rem;
    text-indent: -1.1rem;
  }
  .resume-dash::before {
    content: "— ";
    color: var(--color-text-muted);
  }

  .resume-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: 0.25rem;
  }

  /* The tech line under a role or project title. */
  .resume-stack {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .resume-bullets {
    margin-top: 0.6rem;
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    list-style: disc;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .resume-bullets li::marker {
    color: var(--color-text-faint);
  }

  /* Print: single column, ink-friendly, no site chrome. Deliberately overrides
     the dark theme — a dark-background PDF is unusable and burns toner. */
  @media print {
    @page {
      margin: 14mm;
    }

    :root {
      --color-text-primary: #111;
      --color-text-secondary: #333;
      --color-text-muted: #666;
      --color-text-faint: #888;
      --color-accent: #111;
      --color-border-soft: #ccc;
    }

    html,
    body {
      background: #fff !important;
      color: #111 !important;
    }

    /* Site chrome and anything decorative has no business on paper. */
    header[data-site-header],
    footer[data-site-footer],
    canvas,
    .no-print,
    #scroll-progress,
    [data-cursor-orb] {
      display: none !important;
    }

    .resume {
      max-width: none;
      padding: 0;
    }

    .break-inside-avoid {
      break-inside: avoid;
    }

    a {
      color: #111 !important;
      text-decoration: none;
    }
    /* Links are unclickable on paper — print the destination instead. */
    .resume-head a::after {
      content: " (" attr(href) ")";
      font-size: 0.85em;
      color: #555;
    }
    .resume-head a[href^="mailto:"]::after {
      content: "";
    }
  }
</style>
